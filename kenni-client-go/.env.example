# Kenni OIDC client (required).
# KENNI_ISSUER must NOT have a trailing slash.
KENNI_ISSUER=https://idp.kenni.is/<team-domain>
KENNI_CLIENT_ID=@<team-domain>/<app-id>
KENNI_CLIENT_SECRET=<from-portal>

# Optional: API call feature.
# Set KENNI_API_SCOPE to the scope name your API expects (e.g. @<team>/<api>).
# When set, the app requests this scope at sign-in and the
# "Call protected resource" button becomes available.
# KENNI_API_AUDIENCE defaults to "<KENNI_CLIENT_ID>-api" — set it explicitly
# only if your API tokens use a different aud claim.
KENNI_API_SCOPE=
KENNI_API_AUDIENCE=

# Optional: client-credentials grant.
# Register a separate M2M application in the Kenni portal for this. When all
# three values are set, the "Client credentials grant" button becomes available.
KENNI_M2M_CLIENT_ID=
KENNI_M2M_CLIENT_SECRET=
KENNI_M2M_SCOPE=
