# Kenni OIDC client (required).
#
# All variables use the standardized KENNI_* names — app.config.ts reads
# them from process.env at config-resolution time and forwards them to
# the app via Expo's `extra` (see src/config.ts). No EXPO_PUBLIC_ prefix
# needed.
#
# After editing this file, restart the Expo bundler so app.config.ts
# re-reads process.env.
#
# KENNI_ISSUER must NOT have a trailing slash.
KENNI_ISSUER=https://idp.kenni.is/<team-domain>
KENNI_CLIENT_ID=@<team-domain>/<native-app-id>

# Custom-scheme URI that Kenni redirects to after sign-in. The scheme
# (the part before ://) is parsed out of this value and used as
# expo.scheme in app.config.ts — one source of truth, no drift between
# the redirect URI you register in the developer portal and the scheme
# baked into the native build.
#
# Must be registered in the developer portal as a Redirect URI on this
# application.
KENNI_REDIRECT_URI=is.kenni.expo://callback

# Where Kenni redirects to after RP-initiated logout. Must be registered
# in the developer portal as a Post-logout redirect URI. Same scheme as
# the redirect URI above.
KENNI_POST_LOGOUT_REDIRECT_URI=is.kenni.expo://post-logout
