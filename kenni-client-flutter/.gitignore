# Project-specific (do not commit local config)
dart_defines.json

# Flutter / Dart / Pub
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/doc/api/
**/ios/Flutter/.last_build_id

# Symbolication & obfuscation artifacts (release-build outputs)
app.*.symbols
app.*.map.json

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS
.DS_Store

# Note: ios/.gitignore and android/.gitignore are generated by
# `flutter create` and handle their respective platform build artifacts
# (Pods, .gradle, GeneratedPluginRegistrant, etc.) — don't duplicate
# those rules here.
#
# Note: pubspec.lock IS committed for application projects (gives
# reproducible builds across teammates and CI). Only library packages
# omit it.
