# Kenni OIDC client (required).
# All variables start with KENNI_ — vite.config.ts sets envPrefix accordingly,
# so they are exposed to client code at build time. (No VITE_ prefix needed.)
#
# KENNI_ISSUER must NOT have a trailing slash.
KENNI_ISSUER=https://idp.kenni.is/<team-domain>
KENNI_CLIENT_ID=@<team-domain>/<spa-app-id>

# Where Kenni redirects back to after sign-in. Must be registered in the
# developer portal as a Redirect URI on this application.
KENNI_REDIRECT_URI=http://localhost:3001/callback

# Where Kenni redirects back to after RP-initiated logout. Must be registered
# in the developer portal as a Post-logout redirect URI.
KENNI_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/
