# Kenni OIDC client (required).
# KENNI_ISSUER must NOT have a trailing slash.
KENNI_ISSUER=https://idp.kenni.is/<team-domain>
KENNI_CLIENT_ID=@<team-domain>/<app-id>
KENNI_CLIENT_SECRET=<from-portal>
KENNI_REDIRECT_URI=http://localhost:8000/callback
KENNI_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/

# Optional: API call feature.
# Set KENNI_API_SCOPE to the scope name your API expects (e.g. @<team>/<api>).
# When set, 02-login.sh requests this scope and 05-protected-resource.sh
# verifies it on the resulting access token.
# KENNI_API_AUDIENCE defaults to "<KENNI_CLIENT_ID>-api"; override only if
# your API tokens use a different aud claim.
KENNI_API_SCOPE=
KENNI_API_AUDIENCE=

# Optional: client-credentials grant (06-client-credentials.sh).
# Register a separate M2M application in the Kenni portal for this. When all
# three values are set, the script runs end-to-end.
KENNI_M2M_CLIENT_ID=
KENNI_M2M_CLIENT_SECRET=
KENNI_M2M_SCOPE=
